// ============================================================
// Programa ejemplo de calculadora ARMv4 (program_mem.hex)
// ============================================================

// Formato simulado: [opcode][rd][rn][rm] + padding
// opcode (4 bits), rd/rn/rm (3 bits c/u)
00000000 // NOP
00000001 // MOV R0, 5
10000010 // MOV R1, 3
00000100 // ADD R2, R0, R1
00000101 // SUB R3, R0, R1
00000110 // MUL R4, R0, R1
00000111 // DIV R5, R0, R1
