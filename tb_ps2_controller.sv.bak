// ============================================================
// tb_ps2_controller.sv
// Testbench para controlador PS/2
// ============================================================
`timescale 1ns/1ps
module tb_ps2_controller;

    logic clk, reset;
    logic ps2_clk, ps2_data;
    logic [7:0] scancode;
    logic valid;

    ps2_controller uut (
        .clk(clk), .reset(reset),
        .ps2_clk(ps2_clk),
        .ps2_data(ps2_data),
        .scancode(scancode),
        .valid(valid)
    );

    // Reloj FPGA
    always #10 clk = ~clk;

    // Simulación del reloj PS/2 (más lento)
    always #200 ps2_clk = ~ps2_clk;

    task send_byte(input [7:0] code);
        integer i;
        reg parity;
        begin
            parity = ~^code; // bit de paridad impar

            // bit de inicio
            ps2_data = 0; #4000;

            // bits de datos (LSB primero)
            for (i = 0; i < 8; i = i + 1) begin
                ps2_data = code[i];
                #4000;
            end

            // bit de paridad
            ps2_data = parity; #4000;

            // bit de stop
            ps2_data = 1; #4000;
        end
    endtask

    initial begin
        clk = 0; ps2_clk = 1; ps2_data = 1; reset = 1;
        #100 reset = 0;

        $display("=== Test Controlador PS/2 ===");
        send_byte(8'h1C); // tecla 'A'
        #10000;

        if (valid)
            $display("Tecla recibida: %h", scancode);
        else
            $display("Error: no se detectó tecla");

        $stop;
    end
endmodule
